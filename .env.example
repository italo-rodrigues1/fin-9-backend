DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3333

# OAuth client of type Web application. Must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
# Optional for password login; Google login returns 503 until configured.
GOOGLE_WEB_CLIENT_ID=
